---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import Hero from '../components/Hero.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import Services from '../components/Services.astro';
import Welcome from '../components/Welcome.astro';
import Clients from '../components/Clients.astro';
import Footer from '../components/Footer.astro';
import CursorLabel from '../components/CursorLabel.astro';
---

<BaseLayout>
	<Intro />
	<main>
		<Hero />
		<FeaturedProjects />
		<Services />
		<Welcome />
		<Clients />
		<!-- Testimonials and the contact CTA come next -->
	</main>
	<Footer />
	<CursorLabel />
</BaseLayout>

<style>
	main {
		/* Space before the footer until Testimonials and the CTA are built */
		padding-bottom: 160px;
	}
</style>
