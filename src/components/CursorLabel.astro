---
/*
 * Follows the pointer over any element with a `data-cursor-label` attribute
 * and shows that value as a small label below and to the right of the cursor
 * (Figma: "Custom Cursor Label" over the CIVIC thumbnail).
 *
 * The label is white with `mix-blend-mode: difference`, so it inverts whatever
 * is behind it and stays readable on light and dark parts of an image.
 */
---

<div class="cursor-label t-label" data-cursor-label-el aria-hidden="true"></div>

<style>
	.cursor-label {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 1002;
		color: var(--color-white);
		mix-blend-mode: difference;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		will-change: transform;
	}
</style>

<script>
	import { gsap } from 'gsap';

	// Offset from the cursor tip to the label, measured in Figma
	const OFFSET_X = 15;
	const OFFSET_Y = 12;

	const label = document.querySelector<HTMLElement>('[data-cursor-label-el]');
	const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

	if (label && finePointer) {
		let current: HTMLElement | null = null;

		const show = (target: HTMLElement) => {
			label.textContent = target.dataset.cursorLabel ?? '';
			current = target;
			gsap.to(label, { opacity: 1, duration: 0.25, ease: 'power2.out', overwrite: 'auto' });
		};

		const hide = () => {
			current = null;
			gsap.to(label, { opacity: 0, duration: 0.2, ease: 'power2.out', overwrite: 'auto' });
		};

		window.addEventListener(
			'pointermove',
			(event) => {
				// Locked to the cursor, no easing
				label.style.transform = `translate3d(${event.clientX + OFFSET_X}px, ${event.clientY + OFFSET_Y}px, 0)`;

				// Stay hidden while the intro is playing
				const target = document.documentElement.classList.contains('intro-pending')
					? null
					: (event.target as Element | null)?.closest<HTMLElement>('[data-cursor-label]') ?? null;

				if (target && target !== current) show(target);
				else if (!target && current) hide();
			},
			{ passive: true },
		);

		document.documentElement.addEventListener('pointerleave', () => current && hide());
	}
</script>
