---
/*
 * Follows the pointer over any element with a `data-cursor-label` attribute
 * and shows that value as a small label below and to the right of the cursor
 * (Figma: "Custom Cursor Label" over the CIVIC thumbnail).
 */
---

<div class="cursor-label t-label" data-cursor-label-el aria-hidden="true"></div>

<style>
	.cursor-label {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 1002;
		color: var(--color-brand);
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
	}
</style>

<script>
	import { gsap } from 'gsap';

	// Offset from the cursor tip to the label, measured in Figma
	const OFFSET_X = 15;
	const OFFSET_Y = 12;

	const label = document.querySelector<HTMLElement>('[data-cursor-label-el]');
	const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

	if (label && finePointer) {
		const xTo = gsap.quickTo(label, 'x', { duration: 0.5, ease: 'power3.out' });
		const yTo = gsap.quickTo(label, 'y', { duration: 0.5, ease: 'power3.out' });
		let current: HTMLElement | null = null;

		const show = (target: HTMLElement, x: number, y: number) => {
			label.textContent = target.dataset.cursorLabel ?? '';
			// Start at the cursor rather than sliding in from wherever it was last
			if (!current) {
				gsap.set(label, { x: x + OFFSET_X, y: y + OFFSET_Y + 6 });
				xTo(x + OFFSET_X, x + OFFSET_X);
				yTo(y + OFFSET_Y, y + OFFSET_Y + 6);
			}
			current = target;
			gsap.to(label, { opacity: 1, duration: 0.4, ease: 'power2.out', overwrite: 'auto' });
		};

		const hide = () => {
			current = null;
			gsap.to(label, { opacity: 0, duration: 0.25, ease: 'power2.out', overwrite: 'auto' });
		};

		window.addEventListener(
			'pointermove',
			(event) => {
				// Stay hidden while the intro is playing
				const target = document.documentElement.classList.contains('intro-pending')
					? null
					: (event.target as Element | null)?.closest<HTMLElement>('[data-cursor-label]') ?? null;

				if (target && target !== current) show(target, event.clientX, event.clientY);
				else if (!target && current) hide();

				xTo(event.clientX + OFFSET_X);
				yTo(event.clientY + OFFSET_Y);
			},
			{ passive: true },
		);

		document.documentElement.addEventListener('pointerleave', () => current && hide());
	}
</script>
