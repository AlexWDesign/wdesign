---
/*
 * Large lowercase link with the orange arrow ("view all projects").
 * Hover: the underline draws in from the left and the arrow nudges along
 * its own 45° direction; on leave the underline retracts to the right.
 */
interface Props {
	href: string;
}

const { href } = Astro.props;
---

<a class="arrow-link t-h3" href={href}>
	<span class="arrow-link__text"><slot /></span>
	<img class="arrow-link__arrow" src="/Link_Arrow.svg" alt="" width="21" height="21" />
</a>

<style>
	.arrow-link {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		color: var(--color-brand);
		text-transform: lowercase;
		white-space: nowrap;
	}

	.arrow-link__text {
		position: relative;
	}

	.arrow-link__text::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 2px;
		height: 3px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: right center;
		transition: transform 0.7s var(--ease-out-expo);
	}

	/* 17px arrow from Figma; the SVG adds 2px around it for the stroke */
	.arrow-link__arrow {
		width: 21px;
		height: 21px;
		margin: -2px;
		transform: translateY(2px);
		transition: transform 0.7s var(--ease-out-expo);
	}

	.arrow-link:hover .arrow-link__text::after,
	.arrow-link:focus-visible .arrow-link__text::after {
		transform: scaleX(1);
		transform-origin: left center;
	}

	.arrow-link:hover .arrow-link__arrow,
	.arrow-link:focus-visible .arrow-link__arrow {
		transform: translate(4px, -2px);
	}

	.arrow-link:focus-visible {
		outline: none;
	}
</style>
